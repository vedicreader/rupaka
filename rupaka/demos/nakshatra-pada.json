    {"type": "toggle", "bind": "show_pada", "label": "Pāda marks", "on": "Shown", "off": "Hidden"},
    {"type": "gate", "id": "where", "prompt": "The point is at {lon}°. Which nakṣatra and which pāda hold it?",
     "options": ["Kṛttikā, pāda 4", "Rohiṇī, pāda 2", "Rohiṇī, pāda 3", "Mṛgaśīrṣa, pāda 1"], "answer": "where", "context": "At {lon}°:",
     "why": "Say how you counted, in one line."},
    {"type": "readout", "after": "where", "label": "The point", "text": "{lon}° → {where}, in {rasi.name}"},
    {"type": "caption", "after": "where", "text": "Each rāśi of 30° holds nine pādas. The lord of **{star.name}** is {star.lord}. Turn the wheel to 30°. Which pāda starts Vṛṣabha?"}
