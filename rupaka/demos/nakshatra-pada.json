  "id": "nakshatra-pada",
  "concept": "nakshatra",
  "title": "Nakṣatra and pāda",
  "ask": "The ecliptic has 27 nakṣatras of 13°20′ each, from 0° Aśvinī. Each nakṣatra has four pādas of 3°20′. A point stands at a longitude.",
  "state": {"lon": 47, "show_pada": false},
  "derive": [
    {"fn": "expr", "expr": "floor(lon * 3 / 40)", "out": "idx"},
    {"fn": "expr", "expr": "floor(lon * 3 / 10) - idx * 4 + 1", "out": "pada"},
    {"fn": "lookup", "table": "stars", "key": "idx", "out": "star"},
    {"fn": "expr", "expr": "floor(lon / 30)", "out": "ri"},
    {"fn": "lookup", "table": "rasis", "key": "ri", "out": "rasi"},
    {"fn": "fmt", "text": "{star.name}, pāda {pada}", "out": "where"}
  ],
  "blocks": [
    {"type": "wheel", "angle": "lon", "label": "The ecliptic, 0° at the top", "lock": "where", "step": 1, "marks": 4, "marks_on": "show_pada",
