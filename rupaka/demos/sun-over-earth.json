{
  "rupaka": 1,
  "id": "sun-over-earth",
  "concept": "time-zones",
  "title": "Noon moves west",
  "ask": "We keep Earth still and move the Sun, as the sky shows it. The Sun goes round Earth one time in 24 hours. That is **15° of longitude each hour**.",
  "state": {"lon": 90},
  "derive": [
    {"fn": "expr", "expr": "lon / 15 - 24 * floor(lon / 360)", "out": "hours"}
  ],
  "blocks": [
    {"type": "gate", "id": "g", "prompt": "It is noon in Dhaka, at 90° east. London is at 0°. How many hours pass before noon comes to London?", "options": [4, 6, 9], "answer": {"is": 6}, "hides": ["hours"], "why": "Say why, in one line."},
    {"type": "scene", "label": "Earth with the Sun above one longitude", "look": "sky", "coords": "globe", "height": 400, "ground": false, "blocks": [
      {"type": "points", "stars": true},
      {"type": "body", "id": "earth", "kind": "globe"},
      {"type": "path", "circle": 24, "tone": "glow", "width": 0.3, "opacity": 0.3},
      {"type": "body", "id": "sun", "kind": "sphere", "size": [1.6], "texture": "sun", "glow": 0.6, "light": true, "orbit": 24, "angle": "lon", "drag": "orbit", "to": "lon", "range": [-180, 180], "nudge": 15, "label": "Sun: drag it round Earth", "lock": "g"},
      {"type": "points", "pts": [[90, 23.8, 0.15], [0, 51.5, 0.15], [139.7, 35.7, 0.15], [31.2, 30, 0.15]], "names": ["Dhaka", "London", "Tokyo", "Cairo"], "tone": "acc", "size": 7},
      {"type": "label3d", "on": "sun", "text": "Noon at {lon}°", "tone": "acc"},
      {"type": "shot", "name": "wide", "turn": 105}]},
    {"type": "readout", "after": "g", "text": "Noon comes to London in {hours:1} hours."},
    {"type": "caption", "after": "g", "text": "The Sun must move 90° to the west, and 90 / 15 is 6 hours. Drag the Sun until it is above Cairo. How many hours is Cairo ahead of London?"}
  ]
}
