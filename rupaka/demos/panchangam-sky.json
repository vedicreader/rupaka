{
  "rupaka": 1,
  "id": "panchangam-sky",
  "concept": "panchangam",
  "title": "Tithi and nakshatra from the Sun and the Moon",
  "ask": "Earth is at the centre. The Sun and the Moon stand on the sky ring. The ring has **27 nakshatras**. A **tithi** is each 12° that the Moon gets ahead of the Sun. Tithi 1 is from 0° to under 12° ahead, and tithi 6 is from 60° to under 72°.",
  "state": {"sun": 212, "moon": 272, "days": 0},
  "derive": [
    {"fn": "expr", "expr": "(sun + 0.9856 * days) - 360 * floor((sun + 0.9856 * days) / 360)", "out": "sunAt"},
    {"fn": "expr", "expr": "(moon + 13.176 * days) - 360 * floor((moon + 13.176 * days) / 360)", "out": "moonAt"},
    {"fn": "expr", "expr": "0.9856 * days", "out": "sunTurn"},
    {"fn": "expr", "expr": "13.176 * days", "out": "moonTurn"},
    {"fn": "expr", "expr": "((moonAt - sunAt) / 360 - floor((moonAt - sunAt) / 360)) * 360", "out": "elong"},
    {"fn": "expr", "expr": "floor(elong / 12) + 1", "out": "tithi"},
    {"fn": "expr", "expr": "sunAt + elong", "out": "ahead"},
    {"fn": "expr", "expr": "floor((moonAt / 360 - floor(moonAt / 360)) * 27)", "out": "nakIdx"},
    {"fn": "expr", "expr": "nakIdx * 40 / 3", "out": "nakFrom"},
    {"fn": "expr", "expr": "nakFrom + 40 / 3", "out": "nakTo"},
    {"fn": "expr", "expr": "floor((tithi - 1) / 15)", "out": "pk"},
    {"fn": "expr", "expr": "tithi - 15 * pk - 1 + pk * floor(tithi / 30)", "out": "ti"},
    {"fn": "expr", "expr": "nakIdx + 1", "out": "nakNo"},
    {"fn": "lookup", "table": "tithis", "key": "ti", "out": "tn"},
    {"fn": "lookup", "table": "nakshatras", "key": "nakIdx", "out": "nk"},
    {"fn": "lookup", "table": "paksha", "key": "pk", "out": "pa"},
    {"fn": "expr", "expr": "floor((sunAt / 360 - floor(sunAt / 360)) * 27)", "out": "sunIdx"},
    {"fn": "lookup", "table": "nakshatras", "key": "sunIdx", "out": "sk"},
    {"fn": "expr", "expr": "7.3 * cos(pi * sunAt / 180)", "out": "sx"},
    {"fn": "expr", "expr": "-7.3 * sin(pi * sunAt / 180)", "out": "sz"},
    {"fn": "expr", "expr": "7.3 * cos(pi * moonAt / 180)", "out": "mx"},
    {"fn": "expr", "expr": "-7.3 * sin(pi * moonAt / 180)", "out": "mz"}
  ],
  "tables": {
    "tithis": [{"id": 0, "name": "Pratipada"}, {"id": 1, "name": "Dwitiya"}, {"id": 2, "name": "Tritiya"}, {"id": 3, "name": "Chaturthi"}, {"id": 4, "name": "Panchami"}, {"id": 5, "name": "Shashthi"}, {"id": 6, "name": "Saptami"}, {"id": 7, "name": "Ashtami"}, {"id": 8, "name": "Navami"}, {"id": 9, "name": "Dashami"}, {"id": 10, "name": "Ekadashi"}, {"id": 11, "name": "Dwadashi"}, {"id": 12, "name": "Trayodashi"}, {"id": 13, "name": "Chaturdashi"}, {"id": 14, "name": "Purnima"}, {"id": 15, "name": "Amavasya"}],
    "nakshatras": [{"id": 0, "name": "Ashwini"}, {"id": 1, "name": "Bharani"}, {"id": 2, "name": "Krittika"}, {"id": 3, "name": "Rohini"}, {"id": 4, "name": "Mrigashira"}, {"id": 5, "name": "Ardra"}, {"id": 6, "name": "Punarvasu"}, {"id": 7, "name": "Pushya"}, {"id": 8, "name": "Ashlesha"}, {"id": 9, "name": "Magha"}, {"id": 10, "name": "P. Phalguni"}, {"id": 11, "name": "U. Phalguni"}, {"id": 12, "name": "Hasta"}, {"id": 13, "name": "Chitra"}, {"id": 14, "name": "Swati"}, {"id": 15, "name": "Vishakha"}, {"id": 16, "name": "Anuradha"}, {"id": 17, "name": "Jyeshtha"}, {"id": 18, "name": "Mula"}, {"id": 19, "name": "P. Ashadha"}, {"id": 20, "name": "U. Ashadha"}, {"id": 21, "name": "Shravana"}, {"id": 22, "name": "Dhanishta"}, {"id": 23, "name": "Shatabhisha"}, {"id": 24, "name": "P. Bhadra"}, {"id": 25, "name": "U. Bhadra"}, {"id": 26, "name": "Revati"}],
    "paksha": [{"id": 0, "name": "Shukla (the bright half)"}, {"id": 1, "name": "Krishna (the dark half)"}]
  },
  "blocks": [
    {"type": "gate", "id": "g", "prompt": "The Sun is at {sunAt:0}° and the Moon is at {moonAt:0}°. Which tithi is it?", "options": [3, 6, 9], "answer": "tithi", "context": "For Sun {sunAt:0}° and Moon {moonAt:0}°:", "why": "Say why, in one line."},
    {"type": "scene", "label": "Earth, Sun and Moon inside the ring of the 27 nakshatras", "look": "sky", "height": 440, "ground": false, "blocks": [
      {"type": "points", "stars": true, "lines": false},
      {"type": "body", "id": "band", "kind": "ring", "size": [6.0, 7.3], "color": "light", "opacity": 0.16, "ticks": 27},
      {"type": "points", "round": 27, "r": 6.65, "tone": "light", "names": ["Ashwini", "Bharani", "Krittika", "Rohini", "Mrigashira", "Ardra", "Punarvasu", "Pushya", "Ashlesha", "Magha", "P. Phalguni", "U. Phalguni", "Hasta", "Chitra", "Swati", "Vishakha", "Anuradha", "Jyeshtha", "Mula", "P. Ashadha", "U. Ashadha", "Shravana", "Dhanishta", "Shatabhisha", "P. Bhadra", "U. Bhadra", "Revati"], "text": 0.95},
      {"type": "body", "id": "nak", "kind": "ring", "size": [6.0, 7.3], "arc": ["nakFrom", "nakTo"], "color": "light", "opacity": 0.4, "after": "g"},
      {"type": "body", "id": "dial", "kind": "ring", "size": [1.45, 1.85], "color": "light", "opacity": 0.18, "ticks": 30},
      {"type": "body", "id": "gap", "kind": "ring", "size": [1.45, 1.85], "arc": ["sunAt", "ahead"], "color": "acc", "opacity": 0.75, "after": "g"},
      {"type": "path", "circle": 5, "tone": "glow", "width": 0.3, "opacity": 0.3},
      {"type": "path", "circle": 3.2, "tone": "light", "width": 0.3, "opacity": 0.35},
      {"type": "path", "pts": [[0, 0, 0], ["sx", 0, "sz"]], "tone": "glow", "width": 0.3, "opacity": 0.8, "after": "g"},
      {"type": "path", "pts": [[0, 0, 0], ["mx", 0, "mz"]], "tone": "light", "width": 0.3, "opacity": 0.8, "after": "g"},
      {"type": "body", "id": "earth", "kind": "sphere", "size": [0.9], "texture": "earth", "spin": 6},
      {"type": "body", "id": "sunWay", "kind": "group", "rot": [0, "sunTurn", 0]},
      {"type": "body", "id": "sun", "kind": "sphere", "size": [0.75], "texture": "sun", "glow": 1, "light": true, "orbit": 5, "angle": "sun", "in": "sunWay"},
      {"type": "body", "id": "moonWay", "kind": "group", "rot": [0, "moonTurn", 0]},
      {"type": "body", "id": "moon", "kind": "sphere", "size": [0.3], "texture": "moon", "orbit": 3.2, "angle": "moon", "in": "moonWay"},
      {"type": "label3d", "on": "moon", "text": "Moon (Chandra)"},
      {"type": "label3d", "on": "earth", "text": "Earth (Bhumi)", "at": [0, -1.2, 0]},
      {"type": "label3d", "at": ["sx", 0, "sz"], "text": "Sun in {sk.name}", "tone": "acc", "after": "g"},
      {"type": "label3d", "at": ["mx", 0, "mz"], "text": "Moon in {nk.name}", "after": "g"},
      {"type": "shot", "name": "high"}]},
    {"type": "slider", "bind": "days", "label": "Days from now", "min": 0, "max": 29.5, "step": 0.5, "lock": "g", "note": "Each day the Moon moves about 13°, and the Sun about 1°."},
    {"type": "readout", "after": "g", "text": "Tithi {tithi}: {tn.name}, {pa.name}. The Moon is in {nk.name}, nakshatra number {nakNo}."},
    {"type": "caption", "after": "g", "text": "The Moon is {elong:0}° ahead of the Sun. Each 12° is one tithi, so 30 tithis make one lunar month. Move the days: both move, but the Moon gains about 12° a day. So one tithi lasts about one day."}
  ]
}
