{
 "rupaka": 1,
 "id": "panchangam-sky",
 "concept": "panchangam",
 "title": "Tithi and nakshatra from the Sun and the Moon",
 "ask": "Earth is at the centre. The Sun and the Moon stand on the sky ring. The ring has **27 nakshatras**. A **tithi** is each 12° that the Moon gets ahead of the Sun.",
 "state": {
  "sun": 212,
  "moon": 272
 },
 "derive": [
  {
   "fn": "expr",
   "expr": "((moon - sun) / 360 - floor((moon - sun) / 360)) * 360",
   "out": "elong"
  },
  {
   "fn": "expr",
   "expr": "floor(elong / 12) + 1",
   "out": "tithi"
  },
  {
   "fn": "expr",
   "expr": "sun + elong",
   "out": "ahead"
  },
  {
   "fn": "expr",
   "expr": "floor((moon / 360 - floor(moon / 360)) * 27)",
   "out": "nakIdx"
  },
  {
   "fn": "expr",
   "expr": "nakIdx * 40 / 3",
   "out": "nakFrom"
  },
  {
   "fn": "expr",
   "expr": "nakFrom + 40 / 3",
   "out": "nakTo"
  },
  {
   "fn": "expr",
   "expr": "floor((tithi - 1) / 15)",
   "out": "pk"
  },
  {
   "fn": "expr",
   "expr": "tithi - 15 * pk - 1",
   "out": "ti"
  },
  {
   "fn": "lookup",
   "table": "tithis",
   "key": "ti",
   "out": "tn"
  },
  {
   "fn": "lookup",
   "table": "nakshatras",
   "key": "nakIdx",
   "out": "nk"
  },
  {
   "fn": "lookup",
   "table": "paksha",
   "key": "pk",
   "out": "pa"
  },
  {
   "fn": "expr",
   "expr": "6.8 * cos(pi * sun / 180)",
   "out": "sx"
  },
  {
   "fn": "expr",
   "expr": "-6.8 * sin(pi * sun / 180)",
   "out": "sz"
  },
  {
   "fn": "expr",
   "expr": "6.8 * cos(pi * moon / 180)",
   "out": "mx"
  },
  {
   "fn": "expr",
   "expr": "-6.8 * sin(pi * moon / 180)",
   "out": "mz"
  }
 ],
