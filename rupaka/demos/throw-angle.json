{
  "rupaka": 1,
  "id": "throw-angle",
  "concept": "projectile-range",
  "title": "The angle of a throw",
  "ask": "A ball leaves the ground at 20 m/s. Gravity bends its path into an arc. The **range** is how far away it lands.",
  "state": {"a": 30, "t": 0.5},
  "derive": [
    {"fn": "expr", "expr": "400 * sin(2 * pi * a / 180) / 9.8", "out": "range"},
    {"fn": "expr", "expr": "x * tan(pi * a / 180) - 9.8 * x * x / (800 * cos(pi * a / 180) ^ 2)", "over": {"x": [0, 42, 169]}, "out": "arc"},
    {"fn": "expr", "expr": "t * 400 * sin(2 * pi * a / 180) / 9.8", "out": "bx"},
    {"fn": "expr", "expr": "max(0, bx * tan(pi * a / 180) - 9.8 * bx * bx / (800 * cos(pi * a / 180) ^ 2))", "out": "by"}
  ],
  "blocks": [
    {"type": "gate", "id": "g", "prompt": "The ball leaves at 30° and lands 35 m away. Which other angle gives the same range?", "options": [45, 60, 75], "answer": {"is": 60}, "hides": ["range"], "why": "Say why, in one line."},
    {"type": "axis", "label": "The path of the ball, seen from the side", "x": [0, 42], "y": [0, 21], "xstep": 5, "ystep": 5, "xlabel": "distance (m)", "ylabel": "height (m)", "height": 320, "blocks": [
      {"type": "plot", "series": "arc", "ghost": true, "label": "the path of the ball"},
      {"type": "point", "x": "bx", "y": "by", "label": "ball", "show": false}]},
    {"type": "row", "blocks": [
      {"type": "slider", "bind": "a", "label": "Angle (degrees)", "min": 10, "max": 80, "step": 5, "lock": "g"},
      {"type": "slider", "bind": "t", "label": "Where the ball is, from launch to landing", "min": 0, "max": 1, "step": 0.05}]},
    {"type": "readout", "after": "g", "text": "At {a}°, the ball lands {range:1} m away."},
    {"type": "caption", "after": "g", "text": "The faint curve is the last throw. Set 30°, then 60°. Both curves end at 35 m, because sin 60° and sin 120° are equal. Which angle gives the longest throw?"}
  ]
}
