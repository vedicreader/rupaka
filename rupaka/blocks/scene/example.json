{
  "rupaka": 1, "id": "scene-example", "title": "How an F-35B hovers",
  "ask": "Step through the scene with D. Predict the push of the roll posts before you see it.",
  "state": {"step": 1, "cam": "wide", "weight": 41900, "fan": 20000, "nozzle": 18000},
  "derive": [{"fn": "expr", "expr": "weight - fan - nozzle", "out": "posts"},
             {"fn": "expr", "expr": "posts / 2", "out": "post"},
             {"fn": "expr", "expr": "fan + nozzle + posts", "out": "lift"},
             {"fn": "expr", "expr": "min(1, max(0, step - 2)) * 95", "out": "tilt"}],
  "blocks": [
    {"type": "scene", "bind": "step", "label": "An F-35B shape, not to scale", "floor": -4.6, "scale": 0.0001, "steps": [
      "This is a simple F-35B shape. To hover, its thrust must hold up its weight.",
      "Behind the cockpit, a lift fan blows air down. It gives about 20,000 pounds-force.",
      "At the tail, the nozzle turns down through 95 degrees.",
      "Now the nozzle points down. It gives about 18,000 pounds-force.",
      "A small roll post in each wing blows air down. The posts keep the wings level.",
      "Add the up arrows. When the up push is equal to the weight, the jet hovers."],
     "blocks": [
      {"type": "body", "id": "fuselage", "kind": "box", "size": [11, 1.2, 1.6]},
      {"type": "body", "id": "nose", "kind": "cone", "size": [0.8, 2.4], "at": [6.7, 0, 0], "rot": [0, 0, -90]},
      {"type": "body", "id": "canopy", "kind": "sphere", "size": [0.75], "at": [3.6, 0.6, 0], "color": "glass"},
      {"type": "body", "id": "wing", "kind": "box", "size": [3.6, 0.18, 10], "at": [-1, -0.1, 0], "round": 0.4},
      {"type": "body", "id": "tailL", "kind": "box", "size": [1.6, 0.14, 2.2], "at": [-5, 0, 1.6], "round": 0.4},
      {"type": "body", "id": "tailR", "kind": "box", "size": [1.6, 0.14, 2.2], "at": [-5, 0, -1.6], "round": 0.4},
      {"type": "body", "id": "finL", "kind": "box", "size": [1.4, 1.8, 0.12], "at": [-4.6, 1.1, 0.7], "rot": [-20, 0, 0], "round": 0.4},
      {"type": "body", "id": "finR", "kind": "box", "size": [1.4, 1.8, 0.12], "at": [-4.6, 1.1, -0.7], "rot": [20, 0, 0], "round": 0.4},
      {"type": "body", "id": "fan", "kind": "cylinder", "size": [0.75, 1.3], "at": [2.4, 0, 0], "color": "dark"},
      {"type": "body", "id": "postL", "kind": "cylinder", "size": [0.2, 0.5], "at": [-1, -0.2, 3.6], "color": "dark"},
      {"type": "body", "id": "postR", "kind": "cylinder", "size": [0.2, 0.5], "at": [-1, -0.2, -3.6], "color": "dark"},
      {"type": "body", "id": "swivel", "kind": "group", "at": [-5.5, 0, 0], "rot": [0, 0, "tilt"], "turn": 2500},
      {"type": "body", "id": "nozzle", "kind": "cylinder", "size": [0.5, 0.6, 1.6], "in": "swivel", "at": [-0.8, 0, 0], "rot": [0, 0, 90], "color": "dark"},
      {"type": "force", "on": "fuselage", "at": [0, -0.7, 0], "dir": [0, -1, 0], "mag": "weight", "label": "weight, {weight} lbf"},
      {"type": "force", "on": "fan", "at": [0, -0.7, 0], "dir": [0, 1, 0], "mag": "fan", "tip": true, "label": "lift fan, {fan} lbf", "step": 2},
      {"type": "label3d", "on": "nozzle", "text": "swivel nozzle", "tone": "acc", "step": 3},
      {"type": "force", "on": "swivel", "at": [-1.7, 0, 0], "dir": [0, 1, 0], "mag": "nozzle", "tip": true, "label": "nozzle, {nozzle} lbf", "step": 4},
      {"type": "force", "on": "postL", "at": [0, -0.3, 0], "dir": [0, 1, 0], "mag": "post", "tip": true, "label": "roll posts, {posts} lbf in all", "step": 5, "after": "hover"},
      {"type": "force", "on": "postR", "at": [0, -0.3, 0], "dir": [0, 1, 0], "mag": "post", "tip": true, "step": 5, "after": "hover"},
      {"type": "label3d", "at": [0, 3.4, 0], "text": "{fan} + {nozzle} + {posts} = {lift} lbf up", "tone": "ok", "step": 6, "after": "hover"},
      {"type": "shot", "bind": "cam"},
      {"type": "shot", "name": "close:fan", "step": 2},
      {"type": "shot", "name": "side", "step": 3},
      {"type": "shot", "name": "front", "step": 5},
      {"type": "shot", "name": "wide", "step": 6}]},
    {"type": "gate", "id": "hover",
     "prompt": "The weight is {weight} lbf. The fan gives {fan} lbf and the nozzle gives {nozzle} lbf. What must the two roll posts give?",
     "options": [1900, 3900, 5900], "answer": "posts"},
    {"type": "caption", "text": "The thrust numbers are from the Wikipedia page Rolls-Royce LiftSystem. The shape is a sketch."}
  ]
}
