      {"type": "layer", "art": "water"}
    ]},
    {"type": "timeline", "bind": "t", "markers": [{"t": 0, "label": "Dawn"}, {"t": 50, "label": "Noon"}, {"t": 100, "label": "Dusk"}]}
  ]
