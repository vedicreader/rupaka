{
  "rupaka": 1, "id": "timeline-example", "title": "Timeline", "mode": "learn",
  "state": {"t": 0},
  "derive": [{"fn": "keyframes", "in": "t", "keys": [[0, 20], [100, 140]], "ease": "inout", "out": "sunx"}],
  "blocks": [
    {"type": "layers", "label": "A sun that crosses the sky", "blocks": [
      {"type": "layer", "art": "sky"},
